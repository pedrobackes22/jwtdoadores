{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "preview": {
      "environment": "preview",
      "env": {
        "ALIMENTA_APK": "1",
        "ALIMENTA_API_PUBLICA": "1"
      },
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "environment": "production",
      "env": { "ALIMENTA_APK": "1", "ALIMENTA_API_PUBLICA": "1" },
      "android": { "buildType": "app-bundle" }
    }
  }
}
