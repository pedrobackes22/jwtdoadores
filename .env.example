# Expo Web no mesmo computador. Reinicie o Expo após alterar a URL.
EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Emulador Android: http://10.0.2.2:3000/api
# Celular físico na mesma rede, somente desenvolvimento: http://IP-DO-COMPUTADOR:3000/api
# Redes diferentes e APK definitivo: API pública HTTPS validada no ambiente EAS.
# Nunca coloque DB_PASSWORD ou JWT_SECRET neste arquivo público.
